<UserControl x:Class="StockAnalyzerApp.CustomControl.ShareValuationDlg.ShareValuationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:StockAnalyzerApp.CustomControl.ShareValuationDlg"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=local:ShareValuationViewModel, IsDesignTimeCreatable=True}">
    <UserControl.DataContext>
        <local:ShareValuationViewModel />
    </UserControl.DataContext>
    <UserControl.Resources>
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Margin" Value="4,3" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>
    <Grid Background="#FFF3F5F8">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="5">
                <TextBlock Text="Share Valuation"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Margin="4,0,4,2" />
                <TextBlock Text="Discounted cash flow method"
                           Foreground="Gray"
                           Margin="4,0,4,16" />
                <Button HorizontalAlignment="Right"      Padding="6,2" Margin="0,0,20,0" Command="{Binding SaveCmd}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M3,1 L13,1 L15,3 L15,13 A1,1 0 0 1 14,14 L2,14 A1,1 0 0 1 1,13 L1,2 A1,1 0 0 1 2,1 Z
                      M4,1 L4,5 L11,5 L11,1 Z
                      M5,8 L11,8 L11,13 L5,13 Z"
              Fill="Gray"
              Stroke="DarkSlateGray"
              StrokeThickness="0.6"
              Width="16" Height="16"
              Margin="0,0,5,0"/>
                        <TextBlock Text="Save" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <GroupBox Grid.Column="0" Header="Share" Margin="4" Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="0.1*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Company" Margin="4" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding StockName, Mode=OneWay}" IsReadOnly="True" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="TradingView symbol" Margin="4" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TradingViewSymbol, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        <Button Grid.Row="1" Grid.Column="2" Content="⟳" FontSize="24" FontWeight="Bold" Height="32"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0,-5,0,0"
                                Command="{Binding LoadFromTradingViewCmd}"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="TradingView country" Margin="4" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding TradingViewCountry, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    </Grid>
                </GroupBox>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <GroupBox Grid.Column="0" Header="Share data" Margin="2" Padding="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1.2*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Close price" Margin="4" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ClosePrice, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Free cash flow per share" Margin="4" />
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding FreeCashFlowPerShare, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Debt per share" Margin="4" />
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding DebtPerShare, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Cash per share" Margin="4" />
                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding CashPerShare, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Download Date" Margin="4" />
                            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding FundamentalDate, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd}}" IsReadOnly="True" BorderThickness="2" BorderBrush="SlateGray"/>


                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Column="1" Header="Valuation assumptions" Margin="2" Padding="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="0.2*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Discount rate" Margin="4" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding DiscountRate, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:P}}" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Growth rate" Margin="4" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding GrowthRate, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:P}}" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Intrinsic value per share" Margin="4" />
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding IntrinsicValue, Mode=OneWay, StringFormat={}{0:F2}}" IsReadOnly="True" BorderThickness="2" BorderBrush="SlateGray"/>

                            <Button Grid.Row="3" Grid.Column="2" Content="⟳" FontSize="24" FontWeight="Bold" Height="32"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0,-5,0,0"
                                Command="{Binding PerformDcfCalculationCmd}"/>
                            
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Premium/Discount" Margin="4" />
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding PremiumDiscount, Mode=OneWay, StringFormat={}{0:P2}}" IsReadOnly="True" BorderThickness="2" BorderBrush="SlateGray"/>


                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Calculation Date" Margin="4" />
                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding CalculationDate, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd}}" IsReadOnly="True" BorderThickness="2" BorderBrush="SlateGray"/>

                        </Grid>
                    </GroupBox>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
