<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:StockAnalyzerApp.CustomControl.TrendDlgs"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             x:Class="StockAnalyzerApp.CustomControl.TrendDlgs.BestTrendUserControl"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" d:Background="WhiteSmoke">
    <UserControl.DataContext>
        <local:BestTrendViewModel></local:BestTrendViewModel>
    </UserControl.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2">
            <Label Margin="2">Group</Label>
            <telerik:RadComboBox Margin="2" Width="100" ItemsSource="{Binding Groups}" SelectedItem="{Binding Group, Mode=TwoWay}"/>
            <Label Margin="2">Duration</Label>
            <telerik:RadComboBox Margin="2" Width="100" ItemsSource="{Binding BarDurations}" SelectedItem="{Binding BarDuration, Mode=TwoWay}"/>
            <Button Margin="20,2,2,2" Name="performBtn" Content="Perform" Click="performBtn_Click"/>
        </StackPanel>
        <StackPanel Grid.Row="1">
            <StackPanel Orientation="Horizontal" Margin="1">
                <Label Width="57">Entry</Label>
                <telerik:RadComboBox SelectedItem="{Binding EntryName}"  ItemsSource="{Binding IndicatorNames}"  Width="250"/>
                <Label Width="57" Content="Event"/>
                <telerik:RadComboBox SelectedItem="{Binding EntryEvent, Mode=TwoWay}" ItemsSource="{Binding EntryEvents}" Width="250"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="1">
                <Label Width="57">Exit</Label>
                <telerik:RadComboBox SelectedItem="{Binding ExitName}"  ItemsSource="{Binding IndicatorNames}"  Width="250"/>
                <Label Width="57" Content="Event"/>
                <telerik:RadComboBox SelectedItem="{Binding ExitEvent, Mode=TwoWay}" ItemsSource="{Binding ExitEvents}" Width="250"/>
            </StackPanel>
        </StackPanel>

        <telerik:RadGridView FontSize="9" Grid.Row="2" ItemsSource="{Binding BestTrends}" IsReadOnly="True" RowIndicatorVisibility="Collapsed"
                             AutoGenerateColumns="False" FilterOperatorsLoading="grid_FilterOperatorsLoading" 
                             SelectionMode="Single" SelectionUnit="FullRow" SelectionChanged="grid_SelectionChanged">
            <telerik:RadGridView.Columns>
                <telerik:GridViewDataColumn Header="Group" DataMemberBinding="{Binding Instrument.Group}"/>
                <telerik:GridViewDataColumn Header="Name" DataMemberBinding="{Binding Instrument.DisplayName}"/>
                <telerik:GridViewDataColumn Header="Entry Date" DataMemberBinding="{Binding StartDate, StringFormat=\{0:d\},ConverterCulture=en-GB}"/>
                <telerik:GridViewDataColumn Header="Entry Value" DataMemberBinding="{Binding StartValue, StringFormat=F2,ConverterCulture=en-GB}"/>
                <telerik:GridViewDataColumn Header="Exit Date" DataMemberBinding="{Binding EndDate, StringFormat=\{0:d\},ConverterCulture=en-GB}"/>
                <telerik:GridViewDataColumn Header="Exit Value" DataMemberBinding="{Binding EndValue, StringFormat=F2,ConverterCulture=en-GB}"/>
                <telerik:GridViewDataColumn Header="Value" DataMemberBinding="{Binding Value, StringFormat=P2}"/>

            </telerik:RadGridView.Columns>
        </telerik:RadGridView>

    </Grid>
</UserControl>
